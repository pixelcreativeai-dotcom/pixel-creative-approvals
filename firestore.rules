rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows reading client information.
     * @path /clients/{clientId}
     * @allow get, list: if true
     * @allow create: if request.auth != null && request.auth.uid == request.resource.data.id;
     * @allow update: if request.auth != null && request.auth.uid == resource.data.id;
     * @allow delete: if request.auth != null && request.auth.uid == resource.data.id;
     * @deny create: if false
     * @deny update: if false
     * @deny delete: if false
     * @principle Allows public read access to client information, but requires authentication to modify.
     */
    match /clients/{clientId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.auth.uid == clientId;
      allow update: if isSignedIn() && isOwner(clientId);
      allow delete: if isSignedIn() && isOwner(clientId);
    }

    /**
     * @description Manages user information, enforcing ownership.
     * @path /users/{userId}
     * @allow get: if isOwner(userId) || isAdmin();
     * @allow list: if isAdmin();
     * @allow create: if isSignedIn() && request.auth.uid == userId;
     * @allow update: if isOwner(userId);
     * @allow delete: if isOwner(userId);
     * @deny create: if false
     * @deny update: if false
     * @deny delete: if false
     * @principle Enforces strict user-ownership for writes, allows admin read access.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Manages campaigns under a specific client, enforcing client-specific access.
     * @path /clients/{clientId}/campaigns/{campaignId}
     * @allow get: if isClientMember(clientId) || isAdmin();
     * @allow list: if isClientMember(clientId) || isAdmin();
     * @allow create: if isClientMember(clientId) || isAdmin();
     * @allow update: if isClientMember(clientId) || isAdmin();
     * @allow delete: if isClientMember(clientId) || isAdmin();
     * @deny create: if false
     * @deny update: if false
     * @deny delete: if false
     * @principle Enforces client-specific access for campaigns, allowing only members of the client to create, update or delete campaigns.
     */
    match /clients/{clientId}/campaigns/{campaignId} {
      allow get: if isClientMember(clientId) || isAdmin();
      allow list: if isClientMember(clientId) || isAdmin();
      allow create: if isSignedIn() && isClientMember(clientId) || isAdmin();
      allow update: if isSignedIn() && isClientMember(clientId) || isAdmin();
      allow delete: if isSignedIn() && isClientMember(clientId) || isAdmin();
    }

    /**
     * @description Manages creatives under a specific campaign, enforcing client and campaign context.
     * @path /clients/{clientId}/campaigns/{campaignId}/creatives/{creativeId}
     * @allow get: if isClientMember(clientId) || isAdmin();
     * @allow list: if isClientMember(clientId) || isAdmin();
     * @allow create: if isClientMember(clientId) || isAdmin();
     * @allow update: if isClientMember(clientId) || isAdmin();
     * @allow delete: if isClientMember(clientId) || isAdmin();
     * @deny create: if false
     * @deny update: if false
     * @deny delete: if false
     * @principle Enforces client-specific access for creatives, allowing only members of the client to create, update or delete creatives.
     */
    match /clients/{clientId}/campaigns/{campaignId}/creatives/{creativeId} {
      allow get: if isClientMember(clientId) || isAdmin();
      allow list: if isClientMember(clientId) || isAdmin();
      allow create: if isSignedIn() && isClientMember(clientId) || isAdmin();
      allow update: if isSignedIn() && isClientMember(clientId) || isAdmin();
      allow delete: if isSignedIn() && isClientMember(clientId) || isAdmin();
    }

    /**
     * @description Manages variations under a specific creative, maintaining hierarchy.
     * @path /clients/{clientId}/campaigns/{campaignId}/creatives/{creativeId}/variations/{variationId}
     * @allow get: if isClientMember(clientId) || isAdmin();
     * @allow list: if isClientMember(clientId) || isAdmin();
     * @allow create: if isClientMember(clientId) || isAdmin();
     * @allow update: if isClientMember(clientId) || isAdmin();
     * @allow delete: if isClientMember(clientId) || isAdmin();
     * @deny create: if false
     * @deny update: if false
     * @deny delete: if false
     * @principle Enforces client-specific access for variations, allowing only members of the client to create, update or delete variations.
     */
    match /clients/{clientId}/campaigns/{campaignId}/creatives/{creativeId}/variations/{variationId} {
      allow get: if isClientMember(clientId) || isAdmin();
      allow list: if isClientMember(clientId) || isAdmin();
      allow create: if isSignedIn() && isClientMember(clientId) || isAdmin();
      allow update: if isSignedIn() && isClientMember(clientId) || isAdmin();
      allow delete: if isSignedIn() && isClientMember(clientId) || isAdmin();
    }

    /**
     * @description Manages comments on creative variations, requiring denormalized clientId and userId.
     * @path /variations/{variationId}/comments/{commentId}
     * @allow get: if isCommentOwner(resource.data.userId, resource.data.clientId) || isAdmin();
     * @allow list: if true; // Public listing allowed for prototyping.
     * @allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
     * @allow update: if isCommentOwner(resource.data.userId, resource.data.clientId) || isAdmin();
     * @allow delete: if isCommentOwner(resource.data.userId, resource.data.clientId) || isAdmin();
     * @deny create: if false
     * @deny update: if false
     * @deny delete: if false
     * @principle Enforces comment ownership by checking userId and clientId, allowing only the owner to update or delete.
     */
    match /variations/{variationId}/comments/{commentId} {
      allow get: if isCommentOwner(resource.data.userId, resource.data.clientId) || isAdmin();
      allow list: if true; // Public listing allowed for prototyping.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isCommentOwner(request.resource.data.userId, request.resource.data.clientId) || isAdmin();
      allow delete: if isCommentOwner(request.resource.data.userId, request.resource.data.clientId) || isAdmin();
    }

    /**
     * @description Manages reusable format specifications, restricting access to admins.
     * @path /formatSpecs/{formatSpecId}
     * @allow get: if true;
     * @allow list: if true;
     * @allow create: if isAdmin();
     * @allow update: if isAdmin() && resource != null;
     * @allow delete: if isAdmin() && resource != null;
     * @deny create: if false
     * @deny update: if false
     * @deny delete: if false
     * @principle Restricts access to format specifications to admins only.
     */
    match /formatSpecs/{formatSpecId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Stores activity logs for auditing, accessible only to admins.
     * @path /activityLogs/{activityLogId}
     * @allow get: if isAdmin();
     * @allow list: if isAdmin();
     * @allow create: if isAdmin(); // Consider removing create permission to prevent unauthorized log entries.
     * @allow update: if false; // Prevent updates to activity logs
     * @allow delete: if false; // Prevent deletion of activity logs
     * @deny create: if false
     * @deny update: if false
     * @deny delete: if false
     * @principle Restricts access to activity logs to admins only.
     */
    match /activityLogs/{activityLogId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin(); // Consider removing create permission to prevent unauthorized log entries.
      allow update: if false; // Prevent updates to activity logs
      allow delete: if false; // Prevent deletion of activity logs
    }
    /**
     * @description Manages admin roles via document existence, allowing admin read access.
     * @path /roles_admin/{userId}
     * @allow get: if isAdmin();
     * @allow list: if false; //Prevents listing of admin roles
     * @allow create: if isAdmin();
     * @allow update: if false;
     * @allow delete: if isAdmin() && resource != null;
     * @deny create: if false
     * @deny update: if false
     * @deny delete: if false
     * @principle Allows admins to manage other admin roles.
     */
    match /roles_admin/{userId} {
       allow get: if isAdmin();
       allow list: if false; //Prevents listing of admin roles
       allow create: if isAdmin();
       allow update: if false;
       allow delete: if isAdmin();
    }

    // --- Helper Functions ---

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource based on the userId.
     * @param {string} userId The user ID to compare against the authenticated user's ID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the resource and if the resource exists.
     *              This is used for update and delete operations to prevent acting on non-existent resources.
     * @param {string} userId The user ID to compare against the authenticated user's ID.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is a member of the specified client.
     * @param {string} clientId The client ID to check against the user's clientId.
     * @return {boolean} True if the user is a member of the client, false otherwise.
     */
    function isClientMember(clientId) {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientId == clientId;
    }

    /**
     * @description Checks if the user is a member of the specified client and if the resource exists.
     * @param {string} clientId The client ID to check against the user's clientId.
     * @return {boolean} True if the user is a member of the client and the resource exists, false otherwise.
     */
    function isExistingClientMember(clientId) {
      return isClientMember(clientId) && resource != null;
    }

    /**
     * @description Checks if the user is the owner of the comment based on the userId and clientId.
     * @param {string} userId The user ID to compare against the comment's userId.
     * @param {string} clientId The client ID to compare against the comment's clientId.
     * @return {boolean} True if the user is the owner of the comment, false otherwise.
     */
    function isCommentOwner(userId, clientId) {
      return isSignedIn() && request.auth.uid == userId && get(/databases/$(database)/documents/users/$(userId)).data.clientId == clientId;
    }

    /**
     * @description Checks if the user has the admin role.
     * @return {boolean} True if the user has the admin role, false otherwise.
     */
    function isAdmin() {
        return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}